import time

# Speed values
base_speed = 0.5
boost_multiplier = 2.0
current_speed = base_speed

# Boost timing config
boost_duration = 4.0        # seconds
cooldown_duration = 6.0     # seconds

# Boost state
boost_active = False
boost_start_time = 0
last_boost_time = -cooldown_duration  # allow boost at game start

# Call this when 'b' is pressed
def try_activate_boost():
    global boost_active, boost_start_time, last_boost_time, current_speed
    now = time.time()
    if not boost_active and (now - last_boost_time >= cooldown_duration):
        boost_active = True
        boost_start_time = now
        last_boost_time = now
        current_speed = base_speed * boost_multiplier
        print("BOOST ON")

# Call this every frame to manage duration
def update_boost():
    global boost_active, current_speed
    if boost_active and time.time() - boost_start_time >= boost_duration:
        boost_active = False
        current_speed = base_speed
        print("BOOST OFF")
